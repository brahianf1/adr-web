# Configuración para la plataforma ADR Web
# Copia este archivo a .env y ajusta los valores según sea necesario

# Puerto de la aplicación (usado por Digital Ocean App Platform)
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Configuración de la aplicación
VITE_APP_TITLE=ADR Web - Plataforma Educativa
VITE_APP_DESCRIPTION=Plataforma educativa para estudiar administración
VITE_APP_NAME=ADR Educational Platform

# Ruta base para despliegue (útil para subdirectorios)
VITE_BASE_PATH=/

# Configuración de API (para futura integración con backend)
# VITE_API_URL=http://localhost:3001

# Configuración de tema
VITE_DEFAULT_THEME=light

# Configuración de desarrollo
VITE_DEV_PORT=3000
